{
  "name": "dagu-ocr",
  "title": "大古 OCR",
  "version": "1.0.0",
  "description": "OCR 文字识别与图片翻译，从图片中提取并翻译文字",
  "author": "beierweiwei",
  "logo": "icon.png",
  "main": "index.html",
  "preload": "preload.js",
  "development": {
    "main": "http://127.0.0.1:5173/index.html"
  },
  "width": 780,
  "height": 600,
  "categories": ["media"],
  "features": [
    {
      "code": "screenshot-annotate",
      "explain": "编辑图片",
      "icon": "icon.png",
      "cmds": [
        "截图标注",
        "截屏标注",
        "截图编辑",
        { "type": "img", "label": "编辑图片" }
      ]
    },
    {
      "code": "ocr",
      "explain": "识别图片",
      "icon": "icon.png",
      "cmds": [
        { "type": "img", "label": "识别图片" }
      ]
    },
    {
      "code": "translate",
      "explain": "翻译",
      "icon": "icon.png",
      "cmds": [
        "截图翻译",
        { "type": "img", "label": "翻译图片" }
      ]
    }
  ]
}
